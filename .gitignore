# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Builds & tooling ─────────────────────────────────────────
dist/
build/
coverage/
*.tsbuildinfo
node_modules/.tmp/

# ── Environment & secrets (never commit these) ───────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Convex local state ───────────────────────────────────────
.convex/
.convex-data/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Trained model artifacts (generated by training scripts) ──
backend/model/*.pkl
backend/model/metrics.json

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── OS / editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
